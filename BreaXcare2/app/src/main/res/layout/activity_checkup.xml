<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.DashboardActivity">

    <FrameLayout
        android:id="@+id/topMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />

    <!-- Card View Below Top Menu -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="700dp"
        app:cardCornerRadius="12dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFC9CC"
        app:layout_constraintTop_toBottomOf="@id/topMenuContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/marked_image"
            android:layout_width="100dp"
            android:layout_height="100dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/imageCard"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_margin="16dp"
                app:cardBackgroundColor="#EFEFEF"
                app:cardCornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/topMenuContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- First Row: Left and Right Aligned TextViews -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your privacy is our priority. We don’t store your sensitive images or share your information with third parties."
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_marginBottom="40dp" />


                    <ImageView
                        android:id="@+id/ic_mammogram_img"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="15dp"
                        android:contentDescription="Item 4"
                        android:src="@drawable/ic_mamogramimg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_uploadimg"
                        android:layout_width="140dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:background="@drawable/rounded_btnstroke_background"
                        android:padding="0dp"
                        android:text="Upload Image"
                        android:textColor="#FF4081"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:strokeColor="#FF4081"
                        app:strokeWidth="2dp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btn_analyze"
                android:layout_width="300dp"
                android:layout_height="45dp"
                android:backgroundTint="#FF4081"
                android:text="Analyze"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal"
                android:drawableLeft="@drawable/ic_analyze"
                android:drawablePadding="200dp"
                android:paddingStart="100dp"
                android:paddingEnd="100dp" />


            <androidx.cardview.widget.CardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/topMenuContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- First Row: Left and Right Aligned TextViews -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/textView1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your breast cancer risk analysis indicates,"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="#808080"
                            android:layout_weight="1"/>

                    </LinearLayout>

                    <!-- Risk Level Text -->
                    <TextView
                        android:id="@+id/txt_risk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Risk"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FF4081"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progress="70"
                        android:max="100"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/custom_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal" />

                    <!-- Percentage Text -->
                    <TextView
                        android:id="@+id/progressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90%"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="8dp" />
                </LinearLayout>

                    <TextView
                        android:id="@+id/txt_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on your last checkup, you're in the Lower than average risk category for developing breast cancer"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <FrameLayout
        android:id="@+id/bottomMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.constraintlayout.widget.ConstraintLayout>
