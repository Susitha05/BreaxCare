<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".views.usershandler.LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal"
        tools:ignore="MissingConstraints">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFC1CC"
            android:layout_marginTop="60dp"
            android:alpha="0.9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back !"
                    android:textColor="#FF4081"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="@drawable/rounded_edit_text_background"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="User Icon"
                        android:layout_gravity="center_vertical"
                        android:paddingRight="4dp"
                        app:tint="#FF4081" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:hint="Username or Email"
                        android:textSize="17dp"
                        android:textColorHint="#808080"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="@drawable/rounded_edit_text_background"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_password"
                        android:contentDescription="Password Icon"
                        android:layout_gravity="center_vertical"
                        android:paddingRight="4dp"
                        app:tint="#FF4081" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:hint="Password"
                        android:textSize="17dp"
                        android:textColorHint="#808080"
                        android:textColor="@color/black"
                        android:inputType="textPassword"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent" />

                    <ImageView
                        android:id="@+id/passview"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_passview"
                        android:contentDescription="Password Icon"
                        android:layout_gravity="center_vertical"
                        android:paddingRight="4dp"
                        android:clickable="true"
                        app:tint="#FF4081" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textColor="#FF4081"
                    android:textStyle="bold"
                    android:layout_gravity="end"/>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#FF4081"
                    android:text="Login"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:layout_gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Or -"
                    android:textColor="#808080"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signin with"
                    android:textColor="#808080"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <ImageView
                        android:id="@+id/iv_google"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_google"
                        android:contentDescription="Google Sign-In"
                        android:background="@drawable/circular_background"
                        android:padding="5dp"/>

                    <ImageView
                        android:id="@+id/iv_apple"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_apple"
                        android:contentDescription="Apple Sign-In"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/circular_background"
                        android:padding="5dp"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/tv_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms and Services"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:background="@drawable/circular_background"
            android:alpha="0.9">

            <ImageView
                android:id="@+id/iv_linkedin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_linkedin"
                android:contentDescription="LinkedIn"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>

            <ImageView
                android:id="@+id/iv_instagram"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_instagram"
                android:contentDescription="Instagram"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>

            <ImageView
                android:id="@+id/iv_youtube"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_youtube"
                android:contentDescription="YouTube"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Support us"
            android:textColor="#808080"
            android:textStyle="bold"
            android:layout_gravity="center"/>

    </LinearLayout>

</FrameLayout>