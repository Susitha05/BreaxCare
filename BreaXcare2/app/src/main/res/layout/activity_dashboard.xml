<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.DashboardActivity">

    <FrameLayout
        android:id="@+id/topMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />

    <!-- Card View Below Top Menu -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFC9CC"
        app:layout_constraintTop_toBottomOf="@id/topMenuContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- First Row: Left and Right Aligned TextViews -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="you are on,"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_lcdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last checked : null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#808080"/>
            </LinearLayout>

            <!-- Risk Level Text -->
            <TextView
                android:id="@+id/txt_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Havn't Checked yet"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#808080"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="30dp"/>

            <!-- Description Text -->
            <TextView
                android:id="@+id/txt_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Based on your last checkup, you're in the Lower than average risk category for developing breast cancer"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- Action Button -->
            <Button
                android:id="@+id/buttonAction"
                android:layout_width="350dp"
                android:layout_height="40dp"
                android:backgroundTint="#FF4081"
                android:text="Check Now"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Cards in Rows -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/mainCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_qquest"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/MyCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:onClick="onCardClick">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_qquest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick    Questionnaire"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simple questionnaire for check your body signs"
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_alignParentBottom="true" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mhistory"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/MyCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:onClick="onCardClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_mhistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical History"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="30dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on your previous analysis  history, reports"
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_alignParentBottom="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tplan"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/MyCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:onClick="onCardClick">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_tplan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treatment Plan"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create a treatment plan to your diagnositics"
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_alignParentBottom="true" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_consult"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/MyCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:onClick="onCardClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_consult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultations"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="30dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Channel your doctor for further analysis"
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_alignParentBottom="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ytrends"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/MyCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:onClick="onCardClick">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_ytrends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Trends"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track and visualise your symptoms trends"
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_alignParentBottom="true" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_faq"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/MyCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:onClick="onCardClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_faq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FAQ"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="30dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frequent ask questions in our community"
                        android:textSize="12sp"
                        android:textColor="#808080"
                        android:layout_alignParentBottom="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Menu Include -->
    <FrameLayout
        android:id="@+id/bottomMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.constraintlayout.widget.ConstraintLayout>
